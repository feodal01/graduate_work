@startuml admin-request-after-login-sequence-as-is
scale 0.75

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 85
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title Django Admin — запрос после входа (AS-IS)

autonumber

actor "Администратор" as operator
participant "Gateway\nNginx" as gateway

box "Сервис Admin" #FFF7ED
    participant "Django Admin" as admin
    participant "AuthServiceBackend" as backend
    database "Django sessions\nв theatre-db" as sessions
    database "User\nв theatre-db" as users
    database "Каталог\nв theatre-db" as catalog
    database "django_admin_log\nв theatre-db" as audit
end box

participant "Auth API" as auth

note over admin, auth
  Клиент делает не больше двух попыток с exponential backoff и full jitter.
  Ошибка установки соединения допускает повтор любого метода.
  GET также допускает повтор ошибки чтения, удалённого протокола и HTTP 502, 503, 504.
  POST не повторяется после ошибки ответа.
end note

note over operator, admin
  Маршруты этого общего потока:
  GET /admin/
  GET|POST /admin/password_change/
  GET /admin/password_change/done/
  GET /admin/autocomplete/
  GET /admin/jsi18n/
  GET /admin/r/{content_type_id}/{object_id}/
  GET /admin/movies/
  GET|POST /admin/movies/genre/
  GET|POST /admin/movies/genre/add/
  GET /admin/movies/genre/{object_id}/history/
  GET|POST /admin/movies/genre/{object_id}/delete/
  GET|POST /admin/movies/genre/{object_id}/change/
  GET /admin/movies/genre/{object_id}/
  GET|POST /admin/movies/person/
  GET|POST /admin/movies/person/add/
  GET /admin/movies/person/{object_id}/history/
  GET|POST /admin/movies/person/{object_id}/delete/
  GET|POST /admin/movies/person/{object_id}/change/
  GET /admin/movies/person/{object_id}/
  GET|POST /admin/movies/filmwork/
  GET|POST /admin/movies/filmwork/add/
  GET /admin/movies/filmwork/{object_id}/history/
  GET|POST /admin/movies/filmwork/{object_id}/delete/
  GET|POST /admin/movies/filmwork/{object_id}/change/
  GET /admin/movies/filmwork/{object_id}/
  GET|POST /admin/{unmatched_path}
end note

operator -> gateway: GET или POST /admin/{protected_path}\nsession cookie, CSRF token для POST
gateway -> admin: передать запрос
admin -> sessions: загрузить local user_id, backend path и токены

break сессия отсутствует или завершена
    sessions --> admin: сессия не найдена
    admin --> gateway: 302 /admin/login/
    gateway --> operator: 302 /admin/login/
end

sessions --> admin: local user_id + access + refresh
admin -> backend: get_user(local user_id)
backend -> users: SELECT User\nWHERE id = local user_id

break локальный пользователь удалён
    users --> backend: запись не найдена
    backend --> admin: None
    admin -> admin: request.user = AnonymousUser
    admin --> gateway: 302 /admin/login/
    gateway --> operator: 302 /admin/login/
end

users --> backend: технический User
backend --> admin: request.user

note over backend, users
  Локальный User восстанавливает request.user по primary key из сессии.
  AuthIdentity не нужен для этого запроса.
  Пароль и административное право остаются в Auth.
end note

admin -> auth: GET /api/v1/auth/roles\nAuthorization: Bearer access\nдопустим безопасный повтор GET

alt административное право подтверждено
    auth --> admin: 200 список ролей
else access-токен отклонён
    auth --> admin: 401 Unauthorized
    admin -> auth: POST /api/v1/auth/refresh\n{refresh_token}\nповтор только при ошибке установки соединения

    alt refresh отклонён
        auth --> admin: 401 Unauthorized
        break запрос завершён
            admin -> sessions: удалить локальную сессию
            admin --> gateway: 302 /admin/login/
            gateway --> operator: 302 /admin/login/
        end
    else Auth ограничил refresh
        auth --> admin: 429 Too many requests\nRetry-After
        break запрос завершён
            admin --> gateway: 429 страница ограничения\nRetry-After
            gateway --> operator: 429 Too many requests\nRetry-After
        end
    else Auth недоступен при refresh
        auth --> admin: допустимый повтор исчерпан,\nошибка ответа или 5xx
        break запрос завершён
            admin --> gateway: 503 Auth temporarily unavailable
            gateway --> operator: 503 Auth temporarily unavailable
        end
    else refresh выполнен
        auth --> admin: 200 новая пара токенов
        admin -> sessions: заменить access и refresh
        admin -> auth: GET /api/v1/auth/roles\nAuthorization: Bearer new access\nдопустим безопасный повтор GET

        break повторная проверка отклонена
            auth --> admin: 401 или 403
            admin -> sessions: удалить локальную сессию
            admin --> gateway: 302 /admin/login/
            gateway --> operator: 302 /admin/login/
        end

        break Auth ограничил повторную проверку
            auth --> admin: 429 Too many requests\nRetry-After
            admin --> gateway: 429 страница ограничения\nRetry-After
            gateway --> operator: 429 Too many requests\nRetry-After
        end

        break Auth недоступен при повторной проверке
            auth --> admin: допустимый повтор исчерпан,\nошибка ответа или HTTP 500
            admin --> gateway: 503 Auth temporarily unavailable
            gateway --> operator: 503 Auth temporarily unavailable
        end

        auth --> admin: 200 список ролей
    end
else административное право отозвано
    auth --> admin: 403 Forbidden
    break запрос завершён
        admin -> sessions: удалить локальную сессию
        admin --> gateway: 302 /admin/login/
        gateway --> operator: 302 /admin/login/
    end
else Auth ограничил проверку права
    auth --> admin: 429 Too many requests\nRetry-After
    break запрос завершён
        note right of admin
          Целевое представление не вызывается.
          Запись в theatre-db не выполняется.
        end note
        admin --> gateway: 429 страница ограничения\nRetry-After
        gateway --> operator: 429 Too many requests\nRetry-After
    end
else Auth недоступен
    auth --> admin: допустимый повтор исчерпан,\nошибка ответа или HTTP 500
    break запрос завершён
        note right of admin
          Целевое представление не вызывается.
          Запись в theatre-db не выполняется.
        end note
        admin --> gateway: 503 Auth temporarily unavailable
        gateway --> operator: 503 Auth temporarily unavailable
    end
end

alt служебная страница Admin
    admin -> admin: сформировать index, password change,\nJavaScript i18n, redirect или 404
    admin --> gateway: 200, 302 или 404
    gateway --> operator: 200, 302 или 404
else чтение каталога
    admin -> catalog: прочитать фильмы, жанры и персоны
    catalog --> admin: результат
    admin --> gateway: 200
    gateway --> operator: 200
else изменение каталога
    admin -> catalog: создать, изменить или удалить запись
    catalog --> admin: операция выполнена
    admin -> audit: INSERT LogEntry\nuser_id = request.user.id
    audit --> admin: действие связано с локальным User
    admin --> gateway: 200 или 302
    gateway --> operator: 200 или 302
else страница управления ролями
    ref over admin, auth
      Вызовы Auth описаны в
      admin-role-management-sequence-as-is.puml
    end ref
    admin --> gateway: 200 или 302
    gateway --> operator: 200 или 302
end

note over users, audit
  django_admin_log.user_id ссылается на auth_user.id.
  Поэтому стандартному Django Admin нужна локальная запись пользователя.
end note

@enduml
