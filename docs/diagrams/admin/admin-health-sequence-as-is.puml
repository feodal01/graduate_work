@startuml admin-health-sequence-as-is

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title Django Admin — healthcheck (AS-IS)

autonumber

actor "Система мониторинга" as monitor
participant "Gateway\nNginx" as gateway

box "Сервис Admin" #FFF7ED
    participant "Django Admin" as admin
    database "theatre-db" as theatre_db
end box

monitor -> gateway: GET /admin/health
gateway -> admin: GET /health/
admin -> theatre_db: проверить соединение

alt theatre-db доступна
    theatre_db --> admin: соединение установлено
    admin --> gateway: 200 {"status": "ok"}
    gateway --> monitor: 200 {"status": "ok"}
else theatre-db недоступна
    theatre_db --> admin: DatabaseError
    admin --> gateway: 503 {"status": "unavailable"}
    gateway --> monitor: 503 {"status": "unavailable"}
end

@enduml
