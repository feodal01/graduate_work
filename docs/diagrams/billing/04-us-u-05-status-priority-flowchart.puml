@startuml 04-us-u-05-status-priority-flowchart

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam activity {
    BackgroundColor #F8FAFC
    BorderColor #334155
    ArrowColor #334155
    DiamondBackgroundColor #EFF6FF
    DiamondBorderColor #2563EB
    StartColor #0F172A
    EndColor #0F172A
}

title Как выбирается статус и действие на экране «Моя подписка» (US-U-05)

start

:Пользователь открывает экран «Моя подписка» (/billing/);

if (Пользователь вошёл?) then (нет)
    :Редирект на экран входа (/billing/login); <<#FEE2E2>>
    stop
endif

if (Сервис Auth доступен для проверки токена?) then (нет)
    :Экран ошибки 503 «Сервис авторизации временно недоступен»\n(данные не раскрываются); <<#FEE2E2>>
    stop
endif

if (1. Есть платёж «Ожидает оплаты»?) then (да)
    :**Статус: «Ожидает оплаты»**\nДействие: ссылка «Продолжить оплату»\n(локальный статус -> GET в ЮKassa -> редирект или новый платёж при отмене); <<#FEF9C3>>
    stop
endif

if (2. Последняя подписка активна, но доступ ещё не доставлен в Auth?) then (да)
    :**Статус: «Оплачено, доступ активируется»**\nДействие: нет (ждём доставки в Auth); <<#FEF9C3>>
    stop
endif

if (3. Последняя подписка активна (в т.ч. пока возврат «В обработке»)?) then (да)
    :**Статус: «Активна до <дата>»**\nДействие: нет (покупка впрок запрещена); <<#DCFCE7>>
    stop
endif

if (4. Последняя подписка завершена, но возврат по ней ещё «В обработке»?) then (да)
    :**Статус: «Завершена <дата>»**\nДействие: покупка временно заблокирована до завершения возврата; <<#FEF9C3>>
    stop
endif

if (5. Последняя подписка завершена?) then (да)
    :**Статус: «Завершена <дата>»**\nДействие: кнопка «Оформить за 299 ₽»; <<#E2E8F0>>
    stop
endif

if (6. Последняя подписка возвращена?) then (да)
    :**Статус: «Возвращена»**\nДействие: кнопка «Оформить за 299 ₽»; <<#FCE7F3>>
    stop
endif

:**7. Статус: «Нет подписки»** (подписок ещё не было)\nДействие: кнопка «Оформить за 299 ₽»; <<#E2E8F0>>
stop

@enduml
