@startuml ugc-etl-consume-sequence-as-is
scale 0.8

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title UGC ETL — успешный flush батча (AS-IS)

autonumber

participant "Kafka\nтопик ugc.events" as kafka

box "Сервис ETL" #EFF6FF
    participant "UGC ETL" as etl
end box

participant "ClickHouse" as ch

etl -> kafka: poll\nдо 10 000 записей, 8 MiB или 5 с
kafka --> etl: records

loop каждое валидное сообщение
    etl -> etl: разобрать JSON-конверт\nи разложить payload в колонки
end

etl -> ch: INSERT ugc.events
note over ch
  film_watches_mv пишет события фильма
  в film_watches_local.
  page_events_mv пишет click и page_view
  в page_events_local.
end note
ch --> etl: ok
etl -> kafka: Commit offsets
etl -> etl: очистить батч\nзаписать rss_bytes и tracemalloc

@enduml
