@startuml ugc-etl-poison-sequence-as-is
scale 0.8

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title UGC ETL — битое сообщение (AS-IS)

autonumber

participant "Kafka\nтопик ugc.events" as kafka

box "Сервис ETL" #EFF6FF
    participant "UGC ETL" as etl
end box

participant "Kafka\nтопик ugc.events.dlq" as dlq
participant "ClickHouse" as ch

kafka --> etl: record с битым JSON\nили без обязательных полей
etl -> etl: схема конверта не проходит

alt DLQ принял исходные bytes
    etl -> dlq: Produce
    dlq --> etl: ack
    etl -> kafka: Commit офсета яда
    note over ch
      INSERT для яда нет.
      Партиция не останавливается.
    end note
else DLQ недоступен
    dlq --> etl: ошибка публикации
    note over etl, kafka
      Commit не вызывается.
      Сообщение будет прочитано снова.
    end note
end

@enduml
