@startuml movies-api-film-details-sequence-as-is
scale 0.8

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 120
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title Movies API — полная карточка фильма (AS-IS)

autonumber

actor "Зритель" as viewer
participant "Gateway\nNginx" as gateway

box "Сервис фильмов" #EFF6FF
    participant "Movies API" as movies
    database "Movies Redis" as redis
    database "Elasticsearch\nиндекс movies" as elastic
end box

participant "Auth API" as auth

viewer -> gateway: GET /api/v1/films/{film_id}/\nBearer access, если токен есть
gateway -> movies: передать запрос, Authorization\nи X-Request-Id

opt Bearer-токен передан
    movies -> movies: локально проверить access JWT
    break JWT неверен или истёк
        movies --> gateway: 401 + WWW-Authenticate: Bearer
        gateway --> viewer: 401 Unauthorized
    end
end

movies -> redis: GET film:{film_id}

alt карточка есть в Redis
    redis --> movies: фильм с опциональным creation_date
else карточки нет или Redis недоступен
    redis --> movies: cache miss
    movies -> elastic: GET документ фильма
    break фильм не найден
        elastic --> movies: документ не найден
        movies --> gateway: 404 Film not found
        gateway --> viewer: 404 Film not found
    end
    break Elasticsearch недоступен
        elastic --> movies: storage error
        movies --> gateway: 503 Storage is unavailable
        gateway --> viewer: 503 Storage is unavailable
    end
    elastic --> movies: фильм с опциональным creation_date
    movies -> redis: SET film:{film_id}, TTL 300 секунд
    alt запись выполнена
        redis --> movies: OK
    else Redis недоступен
        redis --> movies: RedisError
        movies -> movies: записать ошибку в журнал и продолжить
    end
end

movies -> auth: POST /api/v1/auth/permissions/check\nX-Service-Key + creation_date: date или null\nBearer access, если токен есть
note right of auth
  Movies API передаёт тот же X-Request-Id.
end note

opt первая попытка: timeout, ошибка соединения,\nошибка чтения ответа, 502, 503 или 504
    auth --> movies: транзиентный отказ
    movies -> movies: exponential backoff + full jitter\nожидание не больше 0,5 секунды
    movies -> auth: повторить POST /api/v1/auth/permissions/check
end

alt Auth вернул allowed=true
    auth --> movies: 200 {"allowed": true}
    movies --> gateway: 200 полная карточка
    gateway --> viewer: 200 полная карточка
else Auth вернул allowed=false
    auth --> movies: 200 {"allowed": false}
    movies --> gateway: 403 Film access denied
    gateway --> viewer: 403 Film access denied
else Auth отклонил пользовательский токен
    auth --> movies: 401 Unauthorized
    movies --> gateway: 401 + WWW-Authenticate: Bearer
    gateway --> viewer: 401 Unauthorized
else Auth нарушил внутренний контракт
    auth --> movies: неверный сервисный ключ, 422,\nнеожиданный статус или неверный JSON
    movies --> gateway: 403 Film access denied
    gateway --> viewer: 403 Film access denied
else Auth ограничил запрос или недоступен
    alt Auth ограничил Movies API
        auth --> movies: 429 Too many requests\nRetry-After
        movies -> movies: записать Retry-After в журнал\nне повторять запрос
    else Auth недоступен
        auth --> movies: 500 без повтора или\nповторный транзиентный отказ
    end
    movies -> movies: применить локальную политику деградации
    alt creation_date известна и фильму не меньше 3 календарных лет
        movies --> gateway: 200 полная карточка
        gateway --> viewer: 200 полная карточка
    else creation_date отсутствует или фильму меньше 3 календарных лет
        movies --> gateway: 403 Film access denied
        gateway --> viewer: 403 Film access denied
    end
end

@enduml
