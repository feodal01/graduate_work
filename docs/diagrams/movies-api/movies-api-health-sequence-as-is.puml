@startuml movies-api-health-sequence-as-is

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90
skinparam responseMessageBelowArrow true
skinparam sequence {
    ArrowColor #334155
    ActorBorderColor #334155
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #E2E8F0
    BoxBorderColor #94A3B8
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #64748B
    GroupBackgroundColor #F8FAFC
}

title Movies API — healthcheck (AS-IS)

autonumber

actor "Система мониторинга" as monitor
participant "Gateway\nNginx" as gateway

box "Сервис фильмов" #EFF6FF
    participant "Movies API" as movies
    database "Movies Redis" as redis
    database "Elasticsearch\nиндекс movies" as elastic
end box

monitor -> gateway: GET /movies/health
gateway -> movies: GET /api/v1/health/
movies -> elastic: ping
elastic --> movies: состояние Elasticsearch
movies -> redis: ping
redis --> movies: состояние Redis

alt Elasticsearch недоступен
    movies --> gateway: 503 {status: unavailable,\nelasticsearch: unavailable, redis: ok или degraded}
    gateway --> monitor: 503 тот же ответ
else Redis недоступен
    movies --> gateway: 200 {status: degraded,\nelasticsearch: ok, redis: degraded}
    gateway --> monitor: 200 тот же ответ
else Elasticsearch и Redis доступны
    movies --> gateway: 200 {status: ok,\nelasticsearch: ok, redis: ok}
    gateway --> monitor: 200 тот же ответ
end

@enduml
