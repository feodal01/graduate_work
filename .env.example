# Notifications: explicit local policy; review these values before deployment.
NOTIFICATIONS_POSTGRES_USER=notifications
NOTIFICATIONS_POSTGRES_PASSWORD=local-notifications-password
NOTIFICATIONS_POSTGRES_DB=notifications
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=local-rabbit-password
NOTIFICATIONS_INITIAL_LIKES=true
NOTIFICATIONS_INITIAL_NEW_FILMS=true
NOTIFICATIONS_INITIAL_MARKETING=false
NOTIFICATIONS_LIKES_MIN_DELTA=3
NOTIFICATIONS_LIKES_INTERVAL_SECONDS=86400
NOTIFICATIONS_FILMS_INTERVAL_SECONDS=604800
# Only the freshest catalog publications; older overflow is not carried forward.
NOTIFICATIONS_FILMS_PER_DIGEST=20
# UTC anchors: date selects cadence/weekday, time selects the preparation hour.
NOTIFICATIONS_LIKES_SCHEDULE_ANCHOR_UTC=1970-01-01T00:00:00Z
NOTIFICATIONS_FILMS_SCHEDULE_ANCHOR_UTC=1970-01-01T00:00:00Z
# Recipient-local time, HH:MM; start inclusive, end exclusive, within one day.
NOTIFICATIONS_SEND_WINDOW_START=10:00
NOTIFICATIONS_SEND_WINDOW_END=20:00
NOTIFICATIONS_LIKES_BOOTSTRAP_LOAD_ID=initial-likes-v1
AUTH_NOTIFICATIONS_LOAD_ID=initial-users-v1
MOVIES_NOTIFICATIONS_LOAD_ID=initial-movies-v1
AUTH_RELAY_BATCH_SIZE=500
AUTH_RELAY_POLL_INTERVAL_SECONDS=1
UGC_RELAY_BATCH_SIZE=500
UGC_BOOTSTRAP_BATCH_SIZE=500
UGC_TRANSACTION_LIFETIME_SECONDS=60
CATALOG_BATCH_SIZE=500
CATALOG_RELAY_BATCH_SIZE=500
CATALOG_LEGACY_BATCH_SIZE=500
CATALOG_SCAN_INTERVAL_SECONDS=60
CATALOG_OVERLAP_SECONDS=120
CATALOG_RECONCILE_INTERVAL_SECONDS=86400
# Local SMTP capture server from compose.yaml; no external mail account required.
NOTIFICATIONS_SMTP_HOST=notifications-mailpit
NOTIFICATIONS_SMTP_PORT=1025
NOTIFICATIONS_SMTP_FROM=cinema@example.test
NOTIFICATIONS_SMTP_STARTTLS=false
NOTIFICATIONS_MAILPIT_UI_PORT=8025
NOTIFICATIONS_FALLBACK_LOCALE=ru
NOTIFICATIONS_FALLBACK_TZ=Europe/Moscow
NOTIFICATIONS_RETRY_SECONDS=60
NOTIFICATIONS_MAX_ATTEMPTS=5
# Auth contacts are fetched only before preparing a letter.
NOTIFICATIONS_AUTH_CONTACTS_TIMEOUT_SECONDS=5
NOTIFICATIONS_AUTH_CONTACTS_RETRY_SECONDS=60
NOTIFICATIONS_AUTH_CONTACTS_BATCH_SIZE=100
# Проверка актуальности access-токена перед чтением и изменением подписок.
NOTIFICATIONS_AUTH_INTROSPECTION_TIMEOUT_SECONDS=2
# Demo retention: erase snapshots and campaign source text one day after terminal_at;
# for recipients skipped without a delivery, count from batch acceptance.
NOTIFICATIONS_DELIVERY_PAYLOAD_RETENTION_SECONDS=86400
NOTIFICATIONS_MAINTENANCE_BATCH_SIZE=100
NOTIFICATIONS_MAINTENANCE_POLL_SECONDS=60

# DEMONSTRATION limits only: approve all rates (tokens/second), bursts and cooldown
# against the SMTP provider before deployment. All worker groups share this account.
NOTIFICATIONS_LIMITER_REDIS_URL=redis://notifications-redis:6379/0
NOTIFICATIONS_LIMITER_ACCOUNT_ID=local-demo-smtp
NOTIFICATIONS_LIMITER_TOTAL_RATE=10
NOTIFICATIONS_LIMITER_TOTAL_CAPACITY=10
NOTIFICATIONS_LIMITER_TRANSACTIONAL_RATE=4
NOTIFICATIONS_LIMITER_TRANSACTIONAL_CAPACITY=4
NOTIFICATIONS_LIMITER_SERVICE_RATE=3
NOTIFICATIONS_LIMITER_SERVICE_CAPACITY=3
NOTIFICATIONS_LIMITER_BULK_RATE=3
NOTIFICATIONS_LIMITER_BULK_CAPACITY=3
NOTIFICATIONS_LIMITER_UNAVAILABLE_RETRY_SECONDS=5
NOTIFICATIONS_LIMITER_REDIS_TIMEOUT_SECONDS=1
NOTIFICATIONS_LIMITER_COOLDOWN_SECONDS=60
NOTIFICATIONS_TRANSACTIONAL_CONCURRENCY=2
NOTIFICATIONS_SERVICE_CONCURRENCY=2
NOTIFICATIONS_BULK_CONCURRENCY=1
NOTIFICATIONS_SCHEDULER_BATCH_SIZE=500
NOTIFICATIONS_RECOVERY_BATCH_SIZE=100
NOTIFICATIONS_CONSUMER_BATCH_SIZE=500
NOTIFICATIONS_CAMPAIGN_BATCH_SIZE=100
NOTIFICATIONS_TRANSACTIONAL_BATCH_SIZE=100
NOTIFICATIONS_SERVICE_BATCH_SIZE=50
NOTIFICATIONS_BULK_BATCH_SIZE=25
NOTIFICATIONS_PUBLISHER_POLL_SECONDS=1

# Internal campaign backend key; replace and restart all campaign API instances to revoke.
NOTIFICATIONS_CAMPAIGN_API_KEY=local-demo-campaign-key

# Billing: PostgreSQL, YooKassa test shop, background worker intervals.
BILLING_POSTGRES_USER=billing
BILLING_POSTGRES_PASSWORD=local-billing-password
BILLING_POSTGRES_DB=billing
# Провайдер для новых платежей; реквизиты каждого — в его переменных (YOOKASSA_*)
PAYMENT_PROVIDER_ACTIVE=yookassa
YOOKASSA_SHOP_ID=replace-with-test-yookassa-shop-id
YOOKASSA_SECRET_KEY=replace-with-test-yookassa-secret-key
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=5.0
BILLING_PUBLIC_BASE_URL=http://localhost
BILLING_RECONCILE_INTERVAL_SECONDS=30.0
# Local development without external webhook tunnel: 5s (in production with webhooks: 60-120s).
RECONCILE_MIN_AGE_SECONDS=5.0
BILLING_OUTBOX_INTERVAL_SECONDS=2.0
BILLING_OUTBOX_MAX_ATTEMPTS=20
BILLING_STUCK_THRESHOLD_SECONDS=600
BILLING_TRACING_ENABLED=true
BILLING_TRACING_SERVICE_NAME=billing
BILLING_TRACING_SAMPLE_RATE=0.05
