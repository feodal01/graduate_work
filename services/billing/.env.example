POSTGRES_USER=billing
POSTGRES_PASSWORD=local-billing-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=billing
POSTGRES_CONNECT_TIMEOUT_SECONDS=5.0
POSTGRES_POOL_TIMEOUT_SECONDS=10.0
POSTGRES_COMMAND_TIMEOUT_SECONDS=15.0
POSTGRES_STATEMENT_TIMEOUT_MS=15000

JWT_SECRET=local-jwt-secret-change-me-000000000000000000
JWT_ALGORITHM=HS256
SERVICE_API_KEY=local-service-key-change-me-00000000000000

AUTH_SERVICE_URL=http://127.0.0.1:8000
AUTH_TIMEOUT_SECONDS=3.0
AUTH_LOGOUT_TIMEOUT_SECONDS=1.5

NOTIFICATIONS_CAMPAIGN_URL=http://127.0.0.1:8004
NOTIFICATIONS_CAMPAIGN_API_KEY=local-demo-campaign-key-change-me-00000000
NOTIFICATIONS_TIMEOUT_SECONDS=5.0

# Провайдер для новых платежей; реквизиты каждого — в его переменных (YOOKASSA_*)
PAYMENT_PROVIDER_ACTIVE=yookassa
YOOKASSA_SHOP_ID=replace-with-test-yookassa-shop-id
YOOKASSA_SECRET_KEY=replace-with-test-yookassa-secret-key
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=5.0
# Розыск возврата в списке ЮKassa: записей на странице (до 100) и предел страниц
YOOKASSA_REFUND_LIST_PAGE_SIZE=100
YOOKASSA_REFUND_LIST_MAX_PAGES=10

BILLING_PUBLIC_BASE_URL=http://localhost
BILLING_RECONCILE_INTERVAL_SECONDS=30.0
RECONCILE_MIN_AGE_SECONDS=5.0
BILLING_OUTBOX_INTERVAL_SECONDS=2.0
BILLING_OUTBOX_MAX_ATTEMPTS=20
# Срок аренды задачи outbox на время доставки; больше тайм-аутов Auth и Notifications
BILLING_OUTBOX_LEASE_SECONDS=60
BILLING_STUCK_THRESHOLD_SECONDS=600
# Ожидающий платёж с номером ЮKassa ждёт пользователя на странице оплаты (около
# часа): «зависшим» он считается после этого порога (не меньше общего)
BILLING_STUCK_WAITING_PAYMENT_THRESHOLD_SECONDS=4200
# Возврат без номера ЮKassa у границы 24-часового ключа (инв. 14): за сколько
# секунд до истечения ключа POST больше не шлётся (меньше 24 ч), сколько пустых
# розысков по списку нужно для отказа «не создан» (не меньше 1) и пауза между ними
BILLING_REFUND_POST_STOP_BEFORE_KEY_EXPIRY_SECONDS=3600
BILLING_REFUND_LOOKUP_NOT_FOUND_ATTEMPTS=2
BILLING_REFUND_LOOKUP_INTERVAL_SECONDS=300
# Вебхук с незнакомым номером (без подписи, его может прислать кто угодно):
# один номер читается у ЮKassa не чаще раза в окно, всех таких чтений в окне
# процесса billing-api — не больше лимита
BILLING_WEBHOOK_PROBE_WINDOW_SECONDS=600
BILLING_WEBHOOK_PROBE_MAX_PER_WINDOW=20
PAGINATION_DEFAULT_PAGE_SIZE=50
PAGINATION_MAX_PAGE_SIZE=100

TRACING_ENABLED=false
TRACING_SERVICE_NAME=billing
TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
TRACING_SAMPLE_RATE=0.05

LOGSTASH_HOST=
LOGSTASH_PORT=5044
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
