POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-theatre-password
POSTGRES_DB=theatre
SQL_HOST=127.0.0.1
SQL_PORT=5432

STATE_DATABASE_FILE_PATH=state/state.sqlite
PRODUCER_BATCH_SIZE=500
CATALOG_BATCH_SIZE=500
CATALOG_RELAY_BATCH_SIZE=500
CATALOG_LEGACY_BATCH_SIZE=500
WORKER_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=movies
ELASTICSEARCH_TIMEOUT_SECONDS=30

POSTGRES_BACKOFF__MAX_TRIES=10
POSTGRES_BACKOFF__INITIAL_DELAY=1.0
POSTGRES_BACKOFF__MAX_DELAY=60.0
POSTGRES_BACKOFF__MULTIPLIER=2.0

ELASTICSEARCH_BACKOFF__MAX_TRIES=5
ELASTICSEARCH_BACKOFF__INITIAL_DELAY=0.5
ELASTICSEARCH_BACKOFF__MAX_DELAY=30.0
ELASTICSEARCH_BACKOFF__MULTIPLIER=2.0
