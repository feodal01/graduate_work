PROJECT_NAME=ugc-api

AUTH_JWT_SECRET=replace-with-the-same-secret-as-auth-service
AUTH_JWT_ALGORITHM=HS256

MONGO_URI=mongodb://127.0.0.1:27019,127.0.0.1:27020
MONGO_DB=ugc
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MAX_PAGE_SIZE=100

# Separate relay process; HTTP API does not require Kafka.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19094
KAFKA_LIKES_TOPIC=ugc.reviews.v1
RELAY_BATCH_SIZE=500
RELAY_POLL_INTERVAL_SECONDS=1
RELAY_BATCH_TIMEOUT_SECONDS=20
RELAY_COMMIT_TIMEOUT_MS=5000
# Must be <= transactionLifetimeLimitSeconds on every shard / replica set.
RELAY_MONGO_TRANSACTION_LIFETIME_SECONDS=60
BOOTSTRAP_BATCH_SIZE=500
