DEBUG=True
SECRET_KEY=replace-with-a-random-secret

POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-theatre-password
POSTGRES_DB=theatre
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_OPTIONS="-c search_path=public,content"

AUTH_SERVICE_URL=http://127.0.0.1:8000/api/v1/auth
AUTH_INTERNAL_URL=http://127.0.0.1:8000/api/v1/internal
AUTH_CLIENT_CONNECT_TIMEOUT_SECONDS=0.5
AUTH_CLIENT_REQUEST_TIMEOUT_SECONDS=1.0
AUTH_CLIENT_BACKOFF_MAX_TRIES=2
AUTH_CLIENT_BACKOFF_MAX_TIME_SECONDS=0.5

BILLING_INTERNAL_URL=http://127.0.0.1:8002/api/v1/internal/billing
BILLING_CLIENT_CONNECT_TIMEOUT_SECONDS=1.0
BILLING_CLIENT_TIMEOUT_SECONDS=5.0
SERVICE_API_KEY=local-service-key-change-me-00000000000000
