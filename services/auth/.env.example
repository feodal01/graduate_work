POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=15
POSTGRES_STATEMENT_TIMEOUT_MS=15000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

SESSION_PASSWORD_CHANGE_MARKER_TTL_SECONDS=120

AUTHORIZATION_CACHE_TTL_SECONDS=300
AUTH_NOTIFICATION_CONTACTS_BATCH_SIZE=100

BACKOFF_MAX_TRIES=3
BACKOFF_MAX_TIME=2.0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

SERVICE_API_KEY=replace-with-at-least-32-random-characters

PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_SCORE=3

AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password

TRACING_ENABLED=true
TRACING_SERVICE_NAME=auth
TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
TRACING_SAMPLE_RATE=0.05

YANDEX_OAUTH_ENABLED=true
YANDEX_OAUTH_CLIENT_ID=replace-with-yandex-client-id
YANDEX_OAUTH_CLIENT_SECRET=replace-with-rotated-yandex-client-secret
YANDEX_OAUTH_REDIRECT_URI=http://localhost/api/v1/auth/social/yandex/callback
YANDEX_OAUTH_STATE_TTL_SECONDS=600
YANDEX_OAUTH_CONNECT_TIMEOUT_SECONDS=1.0
YANDEX_OAUTH_REQUEST_TIMEOUT_SECONDS=3.0
YANDEX_OAUTH_USERINFO_MAX_TRIES=3
YANDEX_OAUTH_USERINFO_BACKOFF_MAX_SECONDS=2.0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_RATE=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_SIGNUP_RATE=3
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
RATE_LIMIT_SIGNUP_CAPACITY=3
RATE_LIMIT_REFRESH_RATE=10
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_CAPACITY=5
RATE_LIMIT_USER_RATE=60
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_USER_CAPACITY=10
RATE_LIMIT_ADMIN_RATE=30
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_CAPACITY=5
RATE_LIMIT_SERVICE_RATE=600
RATE_LIMIT_SERVICE_WINDOW_SECONDS=60
RATE_LIMIT_SERVICE_CAPACITY=50

AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_ADMIN_TZ=Europe/Moscow
