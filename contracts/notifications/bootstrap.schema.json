{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "load_id": {
      "type": "string"
    },
    "expected_count": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "load_id",
    "expected_count",
    "manifest_hash"
  ],
  "additionalProperties": false
}
