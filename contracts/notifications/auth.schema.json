{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "user.registered",
        "user.profile_updated",
        "user.deleted"
      ]
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_version": {
      "type": "integer",
      "minimum": 1
    },
    "tz": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "user_id",
    "user_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "user.deleted"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "tz"
          ]
        }
      },
      "else": {
        "required": [
          "tz"
        ]
      }
    }
  ]
}
