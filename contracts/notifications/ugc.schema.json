{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "review.likes_updated"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "likes_count": {
      "type": "integer",
      "minimum": 0
    },
    "likes_version": {
      "type": "integer",
      "minimum": 0
    },
    "load_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "review_id",
    "user_id",
    "likes_count",
    "likes_version"
  ],
  "additionalProperties": false
}
